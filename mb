#!/usr/bin/env bash
# mb - AI Workstation CLI
# Deploy and manage a self-hosted Ollama + Open WebUI stack on a VPS.
# Part of the 0x10debug VPS tool suite.
#
# Usage:  mb ai <command> [args]
#         mb ai help

set -euo pipefail

MB_AI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${MB_AI_DIR}/lib/common.sh"
# shellcheck source=lib/gpu.sh
source "${MB_AI_DIR}/lib/gpu.sh"
# shellcheck source=lib/model.sh
source "${MB_AI_DIR}/lib/model.sh"
# shellcheck source=lib/ollama-healthcheck.sh
source "${MB_AI_DIR}/lib/ollama-healthcheck.sh"
# shellcheck source=lib/litellm-healthcheck.sh
source "${MB_AI_DIR}/lib/litellm-healthcheck.sh"

# =====================================================================
# Commands
# =====================================================================

mb_ai_deploy() {
    local mode=""
    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gpu) mode="gpu"; shift ;;
            --cpu) mode="cpu"; shift ;;
            *) mb_die "Unknown option: $1 (use --gpu or --cpu)" ;;
        esac
    done

    mb_check_docker

    # Interactive selection if no flag given
    if [[ -z "${mode}" ]]; then
        mb_step "Choose deployment mode"
        if mb_gpu_check; then
            mb_info "NVIDIA GPU detected:"
            mb_gpu_info | sed 's/^/    /'
            if mb_ask "Deploy GPU version?"; then
                mode="gpu"
            else
                mode="cpu"
            fi
        else
            mb_info "No NVIDIA GPU detected; defaulting to CPU mode."
            mode="cpu"
        fi
    fi

    local compose_file env_file
    compose_file=$(mb_compose_file "${mode}")
    env_file=$(mb_env_file)

    # Generate .env if missing
    if [[ ! -f "${env_file}" ]]; then
        mb_step "Generating ${env_file} from .env.example"
        cp "${MB_COMPOSE_DIR}/.env.example" "${env_file}"
        local domain
        domain=$(mb_ask_value "Domain for Open WebUI (leave empty to skip Caddy setup)" "")
        if [[ -n "${domain}" ]]; then
            if grep -q '^AI_DOMAIN=$' "${env_file}"; then
                sed -i.bak "s/^AI_DOMAIN=$/AI_DOMAIN=${domain}/" "${env_file}" && rm -f "${env_file}.bak"
            fi
            mb_success "AI_DOMAIN set to ${domain}"
        else
            mb_info "No domain set. You can edit ${env_file} later."
        fi
    else
        mb_info "Using existing ${env_file}"
    fi

    # Ensure mb-proxy network exists
    if ! docker network ls --format '{{.Name}}' | grep -qx "${MB_PROXY_NETWORK:-mb-proxy}"; then
        mb_warn "Docker network '${MB_PROXY_NETWORK:-mb-proxy}' not found."
        mb_info "Creating it now (or install mb-proxy for full reverse-proxy management)."
        docker network create "${MB_PROXY_NETWORK:-mb-proxy}" >/dev/null
        mb_success "Created network '${MB_PROXY_NETWORK:-mb-proxy}'"
    fi

    # Create data directories
    mb_step "Preparing data directories"
    sudo mkdir -p /data/ollama /data/open-webui
    sudo chown -R "$(id -u):$(id -g)" /data/ollama /data/open-webui 2>/dev/null || true
    mb_success "Data directories ready (/data/ollama, /data/open-webui)"

    # Pull and start
    mb_step "Deploying ${mode^^} stack"
    docker compose -f "${compose_file}" --env-file "${env_file}" pull
    docker compose -f "${compose_file}" --env-file "${env_file}" up -d

    mb_success "AI Workstation deployed (${mode})"
    mb_detail "Open WebUI: http://localhost:${OPEN_WEBUI_PORT:-3000}"
    mb_detail "Ollama API: http://localhost:${OLLAMA_PORT:-11434}"
    mb_detail "Pull a model:  mb ai model pull llama3.1:8b"
    mb_detail "Recommend:     mb ai model recommend"
}

mb_ai_status() {
    mb_check_docker
    mb_step "AI Workstation status"

    echo
    mb_info "Containers:"
    for c in ollama open-webui; do
        local state
        state=$(docker inspect -f '{{.State.Status}}' "${c}" 2>/dev/null || echo "absent")
        if [[ "${state}" == "running" ]]; then
            printf '  %s%-14s%s running %s(healthy)%s\n' "${MB_C_GREEN}" "${c}" "${MB_C_RESET}" "${MB_C_GREEN}" "${MB_C_RESET}"
        else
            printf '  %s%-14s%s %s\n' "${MB_C_RED}" "${c}" "${MB_C_RESET}" "${state}"
        fi
    done

    echo
    if mb_gpu_check; then
        mb_info "GPU:"
        mb_gpu_info | sed 's/^/  /'
        echo
        if docker ps --format '{{.Names}}' | grep -qx ollama; then
            mb_info "GPU usage (Ollama):"
            docker exec ollama nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total \
                --format=csv,noheader 2>/dev/null | sed 's/^/  /' || mb_detail "(nvidia-smi not available in container)"
        fi
    else
        mb_info "GPU: none (CPU mode)"
    fi

    echo
    if docker ps --format '{{.Names}}' | grep -qx ollama; then
        local count
        count=$(docker exec ollama ollama list 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')
        mb_info "Models installed: ${count}"
        if (( count > 0 )); then
            docker exec ollama ollama list 2>/dev/null | sed 's/^/  /'
        fi
    else
        mb_info "Models: (ollama not running)"
    fi
}

mb_ai_model() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "${sub}" in
        list)     mb_model_list "$@" ;;
        pull)     mb_model_pull "$@" ;;
        remove)   mb_model_remove "$@" ;;
        rm)       mb_model_remove "$@" ;;
        recommend) mb_model_recommend "$@" ;;
        *)        mb_die "Usage: mb ai model <list|pull|remove|recommend> [args]" ;;
    esac
}

mb_ai_api() {
    local action="${1:-}"
    [[ $# -gt 0 ]] && shift
    local caddyfile="${MB_COMPOSE_DIR}/Caddyfile"
    local env_file
    env_file=$(mb_env_file)

    case "${action}" in
        enable)
            mb_step "Enabling OpenAI-compatible API"
            if [[ ! -f "${caddyfile}" ]]; then
                cp "${MB_COMPOSE_DIR}/Caddyfile.example" "${caddyfile}"
                mb_info "Created ${caddyfile} from example"
            fi
            # Uncomment the /v1/ route block
            if grep -q '^	# @api path' "${caddyfile}" 2>/dev/null; then
                sed -i.bak \
                    -e 's/^	# @api path/	@api path/' \
                    -e 's/^	# handle @api {/	handle @api {/' \
                    -e 's/^	# 	# @authorized header/		# @authorized header/' \
                    -e 's/^	# 	# handle @authorized {/		# handle @authorized {/' \
                    -e 's/^	# 		reverse_proxy ollama:11434/			reverse_proxy ollama:11434/' \
                    -e 's/^	# 	# }/		# }/' \
                    -e 's/^	# 	# respond 401/		# respond 401/' \
                    -e 's/^	# }/	}/' \
                    "${caddyfile}" && rm -f "${caddyfile}.bak"
                mb_success "API route enabled in ${caddyfile}"
            else
                mb_info "API route already enabled (or Caddyfile structure differs)."
            fi
            # Ensure API_KEY is set
            if ! grep -q '^API_KEY=.' "${env_file}" 2>/dev/null; then
                local key
                key=$(openssl rand -hex 24 2>/dev/null || echo "changeme-$(date +%s)")
                if grep -q '^# API_KEY=' "${env_file}"; then
                    sed -i.bak "s|^# API_KEY=.*|API_KEY=${key}|" "${env_file}" && rm -f "${env_file}.bak"
                else
                    echo "API_KEY=${key}" >> "${env_file}"
                fi
                mb_success "Generated API_KEY in ${env_file}"
                mb_detail "Key: ${key}"
            else
                mb_info "API_KEY already set in ${env_file}"
            fi
            mb_info "Reload Caddy to apply:  caddy reload --config ${caddyfile}"
            mb_detail "Endpoint: https://<your-domain>/v1/chat/completions"
            ;;
        disable)
            mb_step "Disabling OpenAI-compatible API"
            if [[ -f "${caddyfile}" ]] && grep -q '^	@api path' "${caddyfile}" 2>/dev/null; then
                sed -i.bak \
                    -e 's/^	@api path/	# @api path/' \
                    -e 's/^	handle @api {/	# handle @api {/' \
                    "${caddyfile}" && rm -f "${caddyfile}.bak"
                mb_success "API route disabled in ${caddyfile}"
                mb_info "Reload Caddy to apply:  caddy reload --config ${caddyfile}"
            else
                mb_info "API route is already disabled (or Caddyfile not present)."
            fi
            ;;
        *)
            mb_die "Usage: mb ai api <enable|disable>"
            ;;
    esac
}

mb_ai_gpu() {
    local sub="${1:-}"
    case "${sub}" in
        check)
            if mb_gpu_check; then
                mb_success "NVIDIA GPU available"
                mb_gpu_info
            else
                mb_warn "No NVIDIA GPU detected (nvidia-smi missing or no GPU)"
                mb_detail "CPU-only deployment will be used."
                return 1
            fi
            ;;
        *) mb_die "Usage: mb ai gpu check" ;;
    esac
}

mb_ai_update() {
    mb_check_docker
    local env_file
    env_file=$(mb_env_file)
    local mode="cpu"
    if mb_gpu_check && docker inspect ollama >/dev/null 2>&1; then
        if docker inspect ollama 2>/dev/null | grep -q nvidia; then
            mode="gpu"
        fi
    fi
    # Detect from running container if possible
    if docker ps --format '{{.Names}}' | grep -qx ollama; then
        if docker inspect ollama 2>/dev/null | grep -q '"Driver": "nvidia"'; then
            mode="gpu"
        fi
    fi
    local compose_file
    compose_file=$(mb_compose_file "${mode}")
    mb_step "Updating AI Workstation images (${mode})"
    mb_info "Pulling latest images..."
    docker compose -f "${compose_file}" --env-file "${env_file}" pull
    mb_info "Recreating containers..."
    docker compose -f "${compose_file}" --env-file "${env_file}" up -d
    mb_success "AI Workstation updated"
}

mb_ai_rag() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift || true
    case "${sub}" in
        setup)
            bash "${MB_RAG_DIR}/rag-manage.sh" setup "$@"
            ;;
        ingest|collections|query|backup|restore|status|models)
            bash "${MB_RAG_DIR}/rag-manage.sh" "${sub}" "$@"
            ;;
        *)
            mb_die "Usage: mb ai rag <setup|ingest|collections|query|backup|restore|status|models>"
            ;;
    esac
}

# =====================================================================
# ollama-prod — production-grade Ollama + Open WebUI deployment
# =====================================================================

mb_ai_ollama_prod_compose() {
    echo "${MB_COMPOSE_DIR}/ollama-production.yml"
}

mb_ai_ollama_prod_webui_compose() {
    echo "${MB_COMPOSE_DIR}/open-webui.yml"
}

mb_ai_ollama_prod_deploy() {
    local target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gpu)   target="gpu"; shift ;;
            --cpu)   target="cpu"; shift ;;
            --webui) target="webui"; shift ;;
            *) mb_die "Unknown option: $1 (use --gpu, --cpu, or --webui)" ;;
        esac
    done

    mb_check_docker
    local env_file
    env_file=$(mb_env_file)
    [[ -f "${env_file}" ]] || mb_die "Missing ${env_file}. Run 'mb ai deploy' first or copy compose/.env.example."

    # Ensure mb-proxy network exists
    if ! docker network ls --format '{{.Name}}' | grep -qx "${MB_PROXY_NETWORK:-mb-proxy}"; then
        mb_warn "Docker network '${MB_PROXY_NETWORK:-mb-proxy}' not found; creating it."
        docker network create "${MB_PROXY_NETWORK:-mb-proxy}" >/dev/null
        mb_success "Created network '${MB_PROXY_NETWORK:-mb-proxy}'"
    fi

    if [[ "${target}" == "webui" ]]; then
        local webui_compose
        webui_compose=$(mb_ai_ollama_prod_webui_compose)
        mb_step "Deploying Open WebUI (production)"
        mb_info "Requires Ollama to be running on the mb-proxy network."
        docker compose -f "${webui_compose}" --env-file "${env_file}" pull
        docker compose -f "${webui_compose}" --env-file "${env_file}" up -d
        mb_success "Open WebUI deployed (production)"
        mb_detail "Web UI: http://localhost:${OPEN_WEBUI_PORT:-3000}"
        mb_detail "Remember to set ENABLE_SIGNUP=false after creating the admin account."
        return 0
    fi

    # Ollama deploy (cpu or gpu)
    [[ -z "${target}" ]] && mb_die "Specify --gpu, --cpu, or --webui"
    local compose_file
    compose_file=$(mb_ai_ollama_prod_compose)
    # CPU and GPU are mutually exclusive compose profiles so they never
    # collide on the shared `ollama` container name.
    local profile_args=(--profile "${target}")

    if [[ "${target}" == "gpu" ]] && ! mb_gpu_check; then
        mb_warn "No NVIDIA GPU detected; deploying GPU profile anyway."
        mb_detail "The container will fail to start without the NVIDIA Container Toolkit."
    fi

    mb_step "Deploying Ollama (production, ${target})"
    docker compose -f "${compose_file}" "${profile_args[@]}" --env-file "${env_file}" pull
    docker compose -f "${compose_file}" "${profile_args[@]}" --env-file "${env_file}" up -d
    mb_success "Ollama deployed (production, ${target})"
    mb_detail "API: http://127.0.0.1:${OLLAMA_PORT:-11434} (loopback only)"
    mb_detail "Preload models:  mb ai ollama-prod preload"
    mb_detail "Health check:    mb ai ollama-prod health"
}

mb_ai_ollama_prod_preload() {
    bash "${MB_AI_DIR}/scripts/preload-models.sh" "$@"
}

mb_ai_ollama_prod_health() {
    ollama_check_all
}

mb_ai_ollama_prod() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift || true
    case "${sub}" in
        deploy)  mb_ai_ollama_prod_deploy "$@" ;;
        preload) mb_ai_ollama_prod_preload "$@" ;;
        health)  mb_ai_ollama_prod_health "$@" ;;
        *)       mb_die "Usage: mb ai ollama-prod <deploy|preload|health> [args]" ;;
    esac
}

# =====================================================================
# litellm — LiteLLM API gateway deployment & management
# =====================================================================

mb_ai_litellm_compose() {
    echo "${MB_COMPOSE_DIR}/litellm.yml"
}

mb_ai_litellm_proxy_compose() {
    echo "${MB_COMPOSE_DIR}/litellm-proxy.yml"
}

mb_ai_litellm_deploy() {
    local full=0
    local target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full)  full=1; shift ;;
            --gpu)   target="gpu"; shift ;;
            --cpu)   target="cpu"; shift ;;
            *) mb_die "Unknown option: $1 (use --full, --gpu, or --cpu)" ;;
        esac
    done

    mb_check_docker
    local env_file
    env_file=$(mb_env_file)
    [[ -f "${env_file}" ]] || mb_die "Missing ${env_file}. Run 'mb ai deploy' first or copy compose/.env.example."

    # Ensure mb-proxy network exists
    if ! docker network ls --format '{{.Name}}' | grep -qx "${MB_PROXY_NETWORK:-mb-proxy}"; then
        mb_warn "Docker network '${MB_PROXY_NETWORK:-mb-proxy}' not found; creating it."
        docker network create "${MB_PROXY_NETWORK:-mb-proxy}" >/dev/null
        mb_success "Created network '${MB_PROXY_NETWORK:-mb-proxy}'"
    fi

    if (( full == 1 )); then
        # Joint deployment: Ollama + LiteLLM + Open WebUI
        [[ -z "${target}" ]] && mb_die "Specify --cpu or --gpu for --full deployment"
        local proxy_compose
        proxy_compose=$(mb_ai_litellm_proxy_compose)
        local profile_args=(--profile "${target}")

        if [[ "${target}" == "gpu" ]] && ! mb_gpu_check; then
            mb_warn "No NVIDIA GPU detected; deploying GPU profile anyway."
            mb_detail "The container will fail to start without the NVIDIA Container Toolkit."
        fi

        mb_step "Deploying full stack (Ollama + LiteLLM + Open WebUI, ${target})"
        mb_info "Open WebUI will route through LiteLLM (http://litellm:4000)"
        docker compose -f "${proxy_compose}" "${profile_args[@]}" --env-file "${env_file}" pull
        docker compose -f "${proxy_compose}" "${profile_args[@]}" --env-file "${env_file}" up -d
        mb_success "Full stack deployed (Ollama + LiteLLM + Open WebUI, ${target})"
        mb_detail "LiteLLM API:  http://127.0.0.1:${LITELLM_PORT:-4000} (loopback only)"
        mb_detail "Open WebUI:   http://127.0.0.1:${OPEN_WEBUI_PORT:-3000}"
        mb_detail "Ollama API:   http://127.0.0.1:${OLLAMA_PORT:-11434}"
        mb_detail "Health check: mb ai litellm health"
        return 0
    fi

    # LiteLLM-only deployment (assumes Ollama is already running)
    local compose_file
    compose_file=$(mb_ai_litellm_compose)

    # Warn if Ollama is not running — LiteLLM will start but fail health checks
    if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx ollama; then
        mb_warn "Ollama container 'ollama' is not running."
        mb_info "LiteLLM routes to http://ollama:11434 — start Ollama first:"
        mb_detail "  mb ai ollama-prod deploy --cpu   (or --gpu)"
    fi

    mb_step "Deploying LiteLLM API gateway"
    docker compose -f "${compose_file}" --env-file "${env_file}" pull
    docker compose -f "${compose_file}" --env-file "${env_file}" up -d
    mb_success "LiteLLM deployed"
    mb_detail "API:          http://127.0.0.1:${LITELLM_PORT:-4000} (loopback only)"
    mb_detail "Health check: mb ai litellm health"
    mb_detail "Config check: mb ai litellm config-check"
}

mb_ai_litellm_health() {
    litellm_check_all
}

mb_ai_litellm_config_check() {
    litellm_check_config_file
}

mb_ai_litellm() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift || true
    case "${sub}" in
        deploy)       mb_ai_litellm_deploy "$@" ;;
        health)       mb_ai_litellm_health "$@" ;;
        config-check) mb_ai_litellm_config_check "$@" ;;
        *)            mb_die "Usage: mb ai litellm <deploy|health|config-check> [args]" ;;
    esac
}

# =====================================================================
# platform — Apple Silicon guide + vLLM/SGLang alternative engines
# =====================================================================

mb_ai_platform_vllm_compose() {
    echo "${MB_COMPOSE_DIR}/vllm.yml"
}

mb_ai_platform_sglang_compose() {
    echo "${MB_COMPOSE_DIR}/sglang.yml"
}

# Shared helper: ensure the mb-proxy network exists (mirrors other commands)
_mb_ai_platform_ensure_network() {
    if ! docker network ls --format '{{.Name}}' | grep -qx "${MB_PROXY_NETWORK:-mb-proxy}"; then
        mb_warn "Docker network '${MB_PROXY_NETWORK:-mb-proxy}' not found; creating it."
        docker network create "${MB_PROXY_NETWORK:-mb-proxy}" >/dev/null
        mb_success "Created network '${MB_PROXY_NETWORK:-mb-proxy}'"
    fi
}

mb_ai_platform_apple_silicon() {
    local doc="${MB_DOCS_DIR}/apple-silicon.md"
    if [[ ! -f "${doc}" ]]; then
        mb_die "Apple Silicon guide not found: ${doc}"
    fi
    # Print the guide. Use cat so tables/code blocks render as written.
    cat "${doc}"
}

mb_ai_platform_vllm_deploy() {
    mb_check_docker
    local env_file
    env_file=$(mb_env_file)
    [[ -f "${env_file}" ]] || mb_die "Missing ${env_file}. Run 'mb ai deploy' first or copy compose/.env.example."

    if ! mb_gpu_check; then
        mb_warn "No NVIDIA GPU detected; vLLM requires an NVIDIA GPU (CUDA)."
        mb_detail "The container will fail to start without the NVIDIA Container Toolkit."
        mb_detail "For CPU-only or Apple Silicon hosts, use Ollama:  mb ai deploy --cpu"
    fi

    _mb_ai_platform_ensure_network

    local compose_file
    compose_file=$(mb_ai_platform_vllm_compose)
    [[ -f "${compose_file}" ]] || mb_die "vLLM compose file not found: ${compose_file}"

    mb_step "Deploying vLLM inference engine"
    mb_info "Model: ${VLLM_MODEL:-meta-llama/Meta-Llama-3.1-8B-Instruct}"
    mb_info "Tensor parallel size: ${VLLM_TENSOR_PARALLEL_SIZE:-1}"
    docker compose -f "${compose_file}" --env-file "${env_file}" pull
    docker compose -f "${compose_file}" --env-file "${env_file}" up -d

    mb_success "vLLM deployed"
    mb_detail "API:          http://127.0.0.1:${VLLM_PORT:-8000}/v1 (loopback only)"
    mb_detail "Health check: mb ai platform vllm status"
    mb_detail "Stop:         mb ai platform vllm stop"
    mb_detail "Docs:         docs/vllm-alternative.md"
}

mb_ai_platform_vllm_status() {
    mb_check_docker
    mb_step "vLLM status"

    local container="vllm"
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "${container}"; then
        mb_success "${container}: running"
        local model
        model=$(docker inspect "${container}" \
            --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
            | sed -n 's/^VLLM_MODEL=//p' | head -n1)
        [[ -n "${model}" ]] && mb_detail "model: ${model}"
        # Health endpoint
        local health
        health=$(curl -fsS "http://127.0.0.1:${VLLM_PORT:-8000}/health" 2>/dev/null || echo "")
        if [[ -n "${health}" ]]; then
            mb_success "Health: responding"
        else
            mb_warn "Health: not responding (still loading model?)"
        fi
        # GPU usage
        if mb_gpu_check; then
            mb_info "GPU usage (vLLM):"
            docker exec "${container}" nvidia-smi \
                --query-gpu=utilization.gpu,memory.used,memory.total \
                --format=csv,noheader 2>/dev/null | sed 's/^/  /' \
                || mb_detail "(nvidia-smi not available in container)"
        fi
    elif docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "${container}"; then
        mb_warn "${container}: stopped"
    else
        mb_warn "${container}: not deployed (run 'mb ai platform vllm deploy')"
    fi
}

mb_ai_platform_vllm_stop() {
    mb_check_docker
    mb_step "Stopping vLLM"
    local compose_file
    compose_file=$(mb_ai_platform_vllm_compose)
    [[ -f "${compose_file}" ]] || mb_die "vLLM compose file not found: ${compose_file}"
    docker compose -f "${compose_file}" down 2>/dev/null || true
    mb_success "vLLM stopped"
}

mb_ai_platform_sglang_deploy() {
    mb_check_docker
    local env_file
    env_file=$(mb_env_file)
    [[ -f "${env_file}" ]] || mb_die "Missing ${env_file}. Run 'mb ai deploy' first or copy compose/.env.example."

    if ! mb_gpu_check; then
        mb_warn "No NVIDIA GPU detected; SGLang requires an NVIDIA GPU (CUDA)."
        mb_detail "The container will fail to start without the NVIDIA Container Toolkit."
        mb_detail "For CPU-only or Apple Silicon hosts, use Ollama:  mb ai deploy --cpu"
    fi

    _mb_ai_platform_ensure_network

    local compose_file
    compose_file=$(mb_ai_platform_sglang_compose)
    [[ -f "${compose_file}" ]] || mb_die "SGLang compose file not found: ${compose_file}"

    mb_step "Deploying SGLang inference engine"
    mb_info "Model: ${SGLANG_MODEL_PATH:-meta-llama/Meta-Llama-3.1-8B-Instruct}"
    mb_info "Tensor parallel size: ${SGLANG_TENSOR_PARALLEL_SIZE:-1}"
    docker compose -f "${compose_file}" --env-file "${env_file}" pull
    docker compose -f "${compose_file}" --env-file "${env_file}" up -d

    mb_success "SGLang deployed"
    mb_detail "API:          http://127.0.0.1:${SGLANG_PORT:-30000}/v1 (loopback only)"
    mb_detail "Health check: mb ai platform sglang status"
    mb_detail "Stop:         mb ai platform sglang stop"
    mb_detail "Docs:         docs/vllm-alternative.md"
}

mb_ai_platform_sglang_status() {
    mb_check_docker
    mb_step "SGLang status"

    local container="sglang"
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "${container}"; then
        mb_success "${container}: running"
        local model
        model=$(docker inspect "${container}" \
            --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
            | sed -n 's/^SGLANG_MODEL_PATH=//p' | head -n1)
        [[ -n "${model}" ]] && mb_detail "model: ${model}"
        # Health endpoint
        local health
        health=$(curl -fsS "http://127.0.0.1:${SGLANG_PORT:-30000}/health" 2>/dev/null || echo "")
        if [[ -n "${health}" ]]; then
            mb_success "Health: responding"
        else
            mb_warn "Health: not responding (still loading model?)"
        fi
        # GPU usage
        if mb_gpu_check; then
            mb_info "GPU usage (SGLang):"
            docker exec "${container}" nvidia-smi \
                --query-gpu=utilization.gpu,memory.used,memory.total \
                --format=csv,noheader 2>/dev/null | sed 's/^/  /' \
                || mb_detail "(nvidia-smi not available in container)"
        fi
    elif docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "${container}"; then
        mb_warn "${container}: stopped"
    else
        mb_warn "${container}: not deployed (run 'mb ai platform sglang deploy')"
    fi
}

mb_ai_platform_sglang_stop() {
    mb_check_docker
    mb_step "Stopping SGLang"
