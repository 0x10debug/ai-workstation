main() {
    # The CLI namespace is `mb ai <command>`. Accept an optional leading `ai`
    # token so both `mb ai deploy` and `mb deploy` work.
    if [[ "${1:-}" == "ai" ]]; then
        shift
    fi

    local cmd="${1:-help}"
    [[ $# -gt 0 ]] && shift || true
    case "${cmd}" in
        deploy)    mb_ai_deploy "$@" ;;
        status)    mb_ai_status "$@" ;;
        model)     mb_ai_model "$@" ;;
        api)       mb_ai_api "$@" ;;
        gpu)       mb_ai_gpu "$@" ;;
        update)    mb_ai_update "$@" ;;
        rag)       mb_ai_rag "$@" ;;
        ollama-prod) mb_ai_ollama_prod "$@" ;;
        litellm)     mb_ai_litellm "$@" ;;
        cluster)     mb_ai_cluster "$@" ;;
        observability) mb_ai_observability "$@" ;;
        platform)     mb_ai_platform "$@" ;;
        help|-h|--help) mb_ai_help ;;
        *)         mb_error "Unknown command: ${cmd}"; echo; mb_ai_help; exit 1 ;;
    esac
}

main "$@"
