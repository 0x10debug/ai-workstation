# AI Workstation environment configuration
# Copy to .env and fill in values:  cp .env.example .env

# ---- Required ----
# Domain serving Open WebUI (used by Caddy reverse proxy)
AI_DOMAIN=

# ---- Optional (defaults shown) ----
# Host port for Ollama API
# OLLAMA_PORT=11434

# Host port for Open WebUI
# OPEN_WEBUI_PORT=3000

# External Docker network created by mb-proxy
# MB_PROXY_NETWORK=mb-proxy

# API key for OpenAI-compatible endpoint (enable with: mb ai api enable)
# API_KEY=

# ---- LiteLLM API gateway ----
# Host port for LiteLLM (OpenAI-compatible gateway in front of Ollama)
# LITELLM_PORT=4000

# Master key — can call any model and create virtual keys.
# Generate with:  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-master-change-me

# Salt used to hash virtual API keys before storage.
# Generate with:  openssl rand -hex 32
LITELLM_SALT_KEY=sk-litellm-salt-change-me

# Global budget (USD) across all virtual keys. 0 = no global cap.
# LITELLM_MAX_BUDGET=0

# Budget reset window: daily, weekly, or monthly.
# LITELLM_BUDGET_DURATION=monthly

# Log level for LiteLLM (DEBUG, INFO, WARNING, ERROR)
# LITELLM_LOG=INFO

# ---- vLLM high-throughput inference engine ----
# Host port for the vLLM OpenAI-compatible API (NVIDIA GPU required)
# VLLM_PORT=8000

# Hugging Face model to serve (safetensors, not GGUF). Gated models need HF_TOKEN.
# VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Fraction of GPU VRAM to use (0.0–1.0). Raise toward 0.95 on a dedicated GPU.
# VLLM_GPU_MEMORY_UTILIZATION=0.9

# Maximum context length in tokens.
# VLLM_MAX_MODEL_LEN=8192

# Number of GPUs to shard across (tensor parallelism). All GPUs must match.
# VLLM_TENSOR_PARALLEL_SIZE=1

# Maximum concurrent sequences in a batch.
# VLLM_MAX_NUM_SEQS=256

# Quantization: awq, gptq, fp8, or empty for none.
# VLLM_QUANTIZATION=

# Name exposed in /v1/models (defaults to VLLM_MODEL).
# VLLM_SERVED_MODEL_NAME=

# Container memory limit.
# VLLM_MEMORY_LIMIT=32g

# ---- SGLang high-throughput inference engine ----
# Host port for the SGLang OpenAI-compatible API (NVIDIA GPU required)
# SGLANG_PORT=30000

# Hugging Face model to serve (safetensors, not GGUF). Gated models need HF_TOKEN.
# SGLANG_MODEL_PATH=meta-llama/Meta-Llama-3.1-8B-Instruct

# Number of GPUs to shard across (tensor parallelism). All GPUs must match.
# SGLANG_TENSOR_PARALLEL_SIZE=1

# Maximum concurrent running requests.
# SGLANG_MAX_RUNNING_REQUESTS=256

# Maximum context length in tokens.
# SGLANG_CONTEXT_LENGTH=8192

# Quantization: fp8, awq, or empty for none.
# SGLANG_QUANTIZATION=

# Shared memory size for NCCL/tensor parallelism.
# SGLANG_SHM_SIZE=32g

# Container memory limit.
# SGLANG_MEMORY_LIMIT=32g

# ---- Hugging Face (shared by vLLM and SGLang) ----
# Token for downloading gated models (Meta, Mistral, etc.)
# Generate at https://huggingface.co/settings/tokens
# HF_TOKEN=

# ---- Langfuse LLM observability ----
# Host port for the Langfuse UI (loopback only)
# LANGFUSE_PORT=3001

# Host port for the Langfuse Postgres database (loopback only)
# LANGFUSE_DB_PORT=5432

# Host port for the Langfuse Redis cache (loopback only)
# LANGFUSE_REDIS_PORT=6379

# Postgres credentials for the Langfuse database.
# LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse-change-me
# LANGFUSE_DB_NAME=langfuse

# NextAuth secret — signs session JWTs for the Langfuse UI.
# Generate with:  openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=nextauth-secret-change-me

# Public base URL of the Langfuse UI. Set to your domain when behind a
# reverse proxy; use the loopback URL for local-only access.
# LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# Encryption salt for sensitive values (API keys stored in Langfuse).
# Generate with:  openssl rand -hex 32
LANGFUSE_SALT=salt-change-me

# Disable Langfuse telemetry collection (self-hosted privacy).
# LANGFUSE_TELEMETRY_DISABLED=true

# Log level for Langfuse (debug, info, warn, error).
# LANGFUSE_LOG_LEVEL=info
